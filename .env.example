APP_NAME="TG Relay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://RELAY_HOST:8080

# Core
TELEGRAM_API_BASE=https://api.telegram.org
RELAY_PATH_PREFIX=r/CHANGE_ME_16+_RANDOM_CHARS
RELAY_ALLOWED_BOT_IDS=123456789,987654321

# Optional gates
RELAY_KEY=
RELAY_ALLOWED_IPS=
RELAY_RATE_LIMIT_PER_MIN=120

# Timeouts (seconds)
RELAY_CONNECT_TIMEOUT=10
RELAY_TIMEOUT=60
RELAY_FILE_TIMEOUT=120
RELAY_CONNECT_RETRIES=2

# Webhooks (Phase 2)
RELAY_WEBHOOK_REWRITE=false
RELAY_ALLOW_PRIVATE_TARGETS=false
RELAY_WEBHOOK_FORWARD_TIMEOUT=15

# Logging
RELAY_DB_LOGGING=true
RELAY_LOG_RETENTION_DAYS=14

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=sqlite
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=array
